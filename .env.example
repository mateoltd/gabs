NODE_ENV=development
PORT=4310
APP_ORIGIN=http://localhost:4300
API_ORIGIN=http://localhost:4310
DATABASE_URL=postgres://suite_app:suite_local@localhost:54329/suite
MIGRATION_DATABASE_URL=postgres://postgres:postgres_local@localhost:54329/suite
# Development authentication is rejected outside development/test or on non-loopback listeners.
AUTH_MODE=development
HOST=127.0.0.1
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_DESKTOP_CLIENT_ID=
AUTH0_DESKTOP_CALLBACK=http://127.0.0.1:49173/callback
# Required in production for an Auth0 Action that adds the verified MFA claim.
AUTH0_MFA_CLAIM=https://suite.example/mfa
CURRENT_DESKTOP_VERSION=0.1.0
MIN_DESKTOP_VERSION=0.1.0
EXPORT_DIRECTORY=.local/exports
# Optional production settings (set via a secret manager):
# EXPORT_BUCKET=private-suite-exports
# AWS_REGION=eu-west-1
# DESKTOP_UPDATE_URL=https://releases.example.com/feed
# OPERATOR_DATABASE_URL=postgresql://suite_operator:secret@host/suite
# OPERATOR_USER_ID=application-user-uuid-for-the-human-operator
# Module registry signing: run pnpm module keygen for a local development key.
MODULE_SIGNING_DIRECTORY=.local/module-keys
# Release tooling only. Provision a separate login with membership in suite_registry.
# Never configure this credential on the API/worker or clients. Development may use the migration connection.
REGISTRY_DATABASE_URL=
# Set MODULE_SIGNING_PUBLIC_KEY from trusted release infrastructure in production.
# Production API/worker: shared 32-byte hexadecimal key for encrypted query cursors.
# Development/test may omit it; process restart then requires reloading paginated lists.
MODULE_QUERY_CURSOR_KEY=
# Stripe test mode during development. Values are configured in a secret manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODULE_PRICES={}
# Optional desktop LAN transport. Off until explicitly enabled in Settings.
# TLS certificates must cover the configured IP addresses and chain to this CA.
# SUITE_LAN_WORKSPACE=company-workspace-uuid
# SUITE_LAN_CERT=/managed/device.crt
# SUITE_LAN_KEY=/managed/device.key
# SUITE_LAN_CA=/managed/organization-ca.crt
# SUITE_LAN_PEERS=AA:BB:CC:DD:replace-with-full-certificate-fingerprint
# SUITE_LAN_ADDRESSES=192.168.1.20,192.168.1.21
