{
  "name": "modular-business-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.4.1 <13"
  },
  "scripts": {
    "dev:api": "tsx --env-file=.env apps/api/src/main.ts",
    "dev:web": "pnpm --filter @suite/web dev",
    "dev:worker": "tsx --env-file=.env apps/worker/src/main.ts",
    "dev:desktop": "tsx --env-file=.env tooling/desktop-dev.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx --env-file=.env tooling/migrate.ts",
    "db:seed": "tsx --env-file=.env tooling/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node tooling/check-boundaries.mjs && node tooling/check-copy.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "tsx --env-file=.env tooling/load.ts",
    "generate:api": "tsx --env-file=.env tooling/openapi.ts && openapi-typescript docs/openapi.json -o packages/api-client/src/schema.d.ts",
    "build": "pnpm typecheck && pnpm lint && turbo run build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:desktop": "pnpm --filter @suite/desktop build && playwright test --config playwright.desktop.config.ts",
    "test:restore": "tsx --env-file=.env tooling/restore-drill.ts",
    "entitlement": "tsx --env-file=.env tooling/grant-entitlement.ts",
    "generate:tokens": "node tooling/design-tokens.mjs && prettier --write packages/design-tokens/src/values.ts",
    "modules:discover": "node tooling/discover-modules.mjs",
    "module": "tsx tooling/module-cli.ts",
    "pretypecheck": "node tooling/discover-modules.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@suite/module-catalog": "workspace:*",
    "@suite/module-sdk": "workspace:*",
    "@suite/ui-web": "workspace:*",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "kysely": "0.29.5",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "tsx": "4.23.13",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
